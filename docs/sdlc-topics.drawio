<mxfile host="app.diagrams.net" agent="drawio_build">
  <diagram id="1" name="1 SDLC topics">
    <mxGraphModel grid="0" page="1" pageWidth="2490" pageHeight="1555">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Security, privacy, quality, clean code and accessibility across the SDLC&lt;/b&gt;  |  github.com/eranw2000  |  28 October 2026" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=24;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="2420" height="56" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Blue: a skill step Claude runs. Purple: a review agent. Yellow: a standards file. Red: a gate, where you decide or the run stops. Grey: a hook or CI job that runs by itself.&lt;br&gt;The grey italic line in a box names the repo that ships it." style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="92" width="820" height="120" as="geometry"/></mxCell>
        <mxCell id="what" value="&lt;b&gt;What this shows&lt;/b&gt;&lt;br&gt;Where each topic is handled as one change moves from requirements to release. Read a row for one topic, a column for one stage." style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;html=1;" vertex="1" parent="1"><mxGeometry x="870" y="92" width="700" height="120" as="geometry"/></mxCell>
        <mxCell id="src" value="&lt;b&gt;Read from&lt;/b&gt;&lt;br&gt;The main branch of the public repos on GitHub, 28 October 2026. The full flow and the five review checkpoints are the other diagrams in this folder." style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;html=1;" vertex="1" parent="1"><mxGeometry x="1590" y="92" width="860" height="120" as="geometry"/></mxCell>
        <mxCell id="h0" value="Requirements" style="rounded=0;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#0050b3;fontStyle=1;fontSize=20;verticalAlign=middle;align=center;fontFamily=Helvetica;html=1;" vertex="1" parent="1"><mxGeometry x="260" y="250" width="340" height="56" as="geometry"/></mxCell>
        <mxCell id="h1" value="Design" style="rounded=0;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#0050b3;fontStyle=1;fontSize=20;verticalAlign=middle;align=center;fontFamily=Helvetica;html=1;" vertex="1" parent="1"><mxGeometry x="630" y="250" width="340" height="56" as="geometry"/></mxCell>
        <mxCell id="h2" value="Build" style="rounded=0;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#0050b3;fontStyle=1;fontSize=20;verticalAlign=middle;align=center;fontFamily=Helvetica;html=1;" vertex="1" parent="1"><mxGeometry x="1000" y="250" width="340" height="56" as="geometry"/></mxCell>
        <mxCell id="h3" value="Test" style="rounded=0;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#0050b3;fontStyle=1;fontSize=20;verticalAlign=middle;align=center;fontFamily=Helvetica;html=1;" vertex="1" parent="1"><mxGeometry x="1370" y="250" width="340" height="56" as="geometry"/></mxCell>
        <mxCell id="h4" value="Review" style="rounded=0;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#0050b3;fontStyle=1;fontSize=20;verticalAlign=middle;align=center;fontFamily=Helvetica;html=1;" vertex="1" parent="1"><mxGeometry x="1740" y="250" width="340" height="56" as="geometry"/></mxCell>
        <mxCell id="h5" value="Release" style="rounded=0;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#0050b3;fontStyle=1;fontSize=20;verticalAlign=middle;align=center;fontFamily=Helvetica;html=1;" vertex="1" parent="1"><mxGeometry x="2110" y="250" width="340" height="56" as="geometry"/></mxCell>
        <mxCell id="band0" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#cccccc;dashed=1;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="326" width="2420" height="334" as="geometry"/></mxCell>
        <mxCell id="t0" value="Security" style="rounded=0;whiteSpace=wrap;fillColor=#0050b3;strokeColor=#0050b3;fontStyle=1;fontSize=20;fontColor=#ffffff;verticalAlign=middle;align=center;fontFamily=Helvetica;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="326" width="200" height="334" as="geometry"/></mxCell>
        <mxCell id="c0-0-0" value="&lt;b&gt;Security standards&lt;/b&gt;&lt;br&gt;SEC rules that a threat model turns into NFR-SEC requirements.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;secure-dev-guardrails&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;html=1;" vertex="1" parent="1"><mxGeometry x="276" y="342" width="308" height="113" as="geometry"/></mxCell>
        <mxCell id="c0-1-0" value="&lt;b&gt;/threat-model&lt;/b&gt;&lt;br&gt;STRIDE threats at design time. Each mitigation becomes a requirement.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;secure-dev-guardrails&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="1"><mxGeometry x="646" y="342" width="308" height="113" as="geometry"/></mxCell>
        <mxCell id="c0-2-0" value="&lt;b&gt;secret-scan&lt;/b&gt;&lt;br&gt;Blocks a write that carries a credential, and scans staged changes on commit and push.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;secure-dev-guardrails&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;html=1;" vertex="1" parent="1"><mxGeometry x="1016" y="342" width="308" height="134" as="geometry"/></mxCell>
        <mxCell id="c0-2-1" value="&lt;b&gt;dangerous-pattern-warn, sensitive-file-context&lt;/b&gt;&lt;br&gt;Flag injection and weak crypto after an edit; load the matching rules on an auth, crypto or payment path.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;secure-dev-guardrails&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;html=1;" vertex="1" parent="1"><mxGeometry x="1016" y="490" width="308" height="154" as="geometry"/></mxCell>
        <mxCell id="c0-3-0" value="&lt;b&gt;CI security workflow&lt;/b&gt;&lt;br&gt;gitleaks and semgrep security rules on every push.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;secure-dev-guardrails&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;html=1;" vertex="1" parent="1"><mxGeometry x="1386" y="342" width="308" height="113" as="geometry"/></mxCell>
        <mxCell id="c0-4-0" value="&lt;b&gt;deploy-guard&lt;/b&gt;&lt;br&gt;Secrets and PII leaks, config hygiene and stack bugs in the diff.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-review-agents&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;html=1;" vertex="1" parent="1"><mxGeometry x="1756" y="342" width="308" height="113" as="geometry"/></mxCell>
        <mxCell id="c0-4-1" value="&lt;b&gt;/dependency-review&lt;/b&gt;&lt;br&gt;CVEs, licences and supply-chain risk in added packages.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;secure-dev-guardrails&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="1"><mxGeometry x="1756" y="469" width="308" height="113" as="geometry"/></mxCell>
        <mxCell id="c0-5-0" value="&lt;b&gt;/release security scan&lt;/b&gt;&lt;br&gt;Runs the code scanners over what the release changes, on the PR head, before merge.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-release-workflow&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;html=1;" vertex="1" parent="1"><mxGeometry x="2126" y="342" width="308" height="134" as="geometry"/></mxCell>
        <mxCell id="c0-5-1" value="&lt;b&gt;/secrets-remediation&lt;/b&gt;&lt;br&gt;When a secret leaks: rotate, remove, scrub history, verify.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;secure-dev-guardrails&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="1"><mxGeometry x="2126" y="490" width="308" height="113" as="geometry"/></mxCell>
        <mxCell id="band1" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#cccccc;dashed=1;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="676" width="2420" height="166" as="geometry"/></mxCell>
        <mxCell id="t1" value="Privacy" style="rounded=0;whiteSpace=wrap;fillColor=#0050b3;strokeColor=#0050b3;fontStyle=1;fontSize=20;fontColor=#ffffff;verticalAlign=middle;align=center;fontFamily=Helvetica;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="676" width="200" height="166" as="geometry"/></mxCell>
        <mxCell id="c1-0-0" value="&lt;b&gt;Privacy standards&lt;/b&gt;&lt;br&gt;PRIV rules for logging, minimization, retention and deletion, consent, transfers and subject rights.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;secure-dev-guardrails&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;html=1;" vertex="1" parent="1"><mxGeometry x="276" y="692" width="308" height="134" as="geometry"/></mxCell>
        <mxCell id="c1-1-0" value="&lt;b&gt;/threat-model&lt;/b&gt;&lt;br&gt;LINDDUN privacy threats in the same design pass.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;secure-dev-guardrails&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="1"><mxGeometry x="646" y="692" width="308" height="113" as="geometry"/></mxCell>
        <mxCell id="c1-2-0" value="&lt;b&gt;pii-in-logs&lt;/b&gt;&lt;br&gt;Blocks a write that sends personal data to a log.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;secure-dev-guardrails&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;html=1;" vertex="1" parent="1"><mxGeometry x="1016" y="692" width="308" height="113" as="geometry"/></mxCell>
        <mxCell id="c1-3-0" value="&lt;b&gt;CI privacy rules&lt;/b&gt;&lt;br&gt;semgrep privacy rules in the same CI workflow.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;secure-dev-guardrails&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;html=1;" vertex="1" parent="1"><mxGeometry x="1386" y="692" width="308" height="113" as="geometry"/></mxCell>
        <mxCell id="c1-4-0" value="&lt;b&gt;/privacy-review&lt;/b&gt;&lt;br&gt;GDPR and CCPA review; each finding tied to a PRIV rule.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;secure-dev-guardrails&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="1"><mxGeometry x="1756" y="692" width="308" height="113" as="geometry"/></mxCell>
        <mxCell id="band2" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#cccccc;dashed=1;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="858" width="2420" height="293" as="geometry"/></mxCell>
        <mxCell id="t2" value="Quality" style="rounded=0;whiteSpace=wrap;fillColor=#0050b3;strokeColor=#0050b3;fontStyle=1;fontSize=20;fontColor=#ffffff;verticalAlign=middle;align=center;fontFamily=Helvetica;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="858" width="200" height="293" as="geometry"/></mxCell>
        <mxCell id="c2-0-0" value="&lt;b&gt;/analyst with the NFR guide&lt;/b&gt;&lt;br&gt;Turns &amp;quot;fast and secure&amp;quot; into an objective with a number that decides pass or fail.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;multi-phase-skills-framework&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="1"><mxGeometry x="276" y="874" width="308" height="134" as="geometry"/></mxCell>
        <mxCell id="c2-1-0" value="&lt;b&gt;/architect&lt;/b&gt;&lt;br&gt;SPEC with a risks table: likelihood and impact, each with a reason.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;multi-phase-skills-framework&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="1"><mxGeometry x="646" y="874" width="308" height="113" as="geometry"/></mxCell>
        <mxCell id="c2-1-1" value="&lt;b&gt;/plan-gate with plan-auditor&lt;/b&gt;&lt;br&gt;Every weak spot in the plan, boundary risks included, fixed or accepted before code.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;multi-phase-skills-framework&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;html=1;" vertex="1" parent="1"><mxGeometry x="646" y="1001" width="308" height="134" as="geometry"/></mxCell>
        <mxCell id="c2-2-0" value="&lt;b&gt;/tdd&lt;/b&gt;&lt;br&gt;One failing test, then the code to pass it. Picks a test technique from the shape of the behavior.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;multi-phase-skills-framework&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="1"><mxGeometry x="1016" y="874" width="308" height="134" as="geometry"/></mxCell>
        <mxCell id="c2-3-0" value="&lt;b&gt;pr-validator&lt;/b&gt;&lt;br&gt;Runs the PR&amp;#x27;s tests and proves they ran.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-review-agents&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;html=1;" vertex="1" parent="1"><mxGeometry x="1386" y="874" width="308" height="113" as="geometry"/></mxCell>
        <mxCell id="c2-3-1" value="&lt;b&gt;test-integrity-check&lt;/b&gt;&lt;br&gt;Warns about a test that can never run.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-release-workflow&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;html=1;" vertex="1" parent="1"><mxGeometry x="1386" y="1001" width="308" height="113" as="geometry"/></mxCell>
        <mxCell id="c2-4-0" value="&lt;b&gt;/review-round&lt;/b&gt;&lt;br&gt;A pointed prompt per reviewer; every fix you pick is proven by a test that fails without it.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-release-workflow&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="1"><mxGeometry x="1756" y="874" width="308" height="134" as="geometry"/></mxCell>
        <mxCell id="c2-5-0" value="&lt;b&gt;/release&lt;/b&gt;&lt;br&gt;Verdict gate at merge, then a check that the live deploy runs the exact commit pushed.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-release-workflow&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;html=1;" vertex="1" parent="1"><mxGeometry x="2126" y="874" width="308" height="134" as="geometry"/></mxCell>
        <mxCell id="band3" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#cccccc;dashed=1;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="1167" width="2420" height="166" as="geometry"/></mxCell>
        <mxCell id="t3" value="Clean code" style="rounded=0;whiteSpace=wrap;fillColor=#0050b3;strokeColor=#0050b3;fontStyle=1;fontSize=20;fontColor=#ffffff;verticalAlign=middle;align=center;fontFamily=Helvetica;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="1167" width="200" height="166" as="geometry"/></mxCell>
        <mxCell id="c3-1-0" value="&lt;b&gt;/tdd design guides&lt;/b&gt;&lt;br&gt;Deep modules: a small interface over a deep implementation, designed for testability.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;multi-phase-skills-framework&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="1"><mxGeometry x="646" y="1183" width="308" height="134" as="geometry"/></mxCell>
        <mxCell id="c3-2-0" value="&lt;b&gt;/tdd refactor step&lt;/b&gt;&lt;br&gt;Refactor only while the tests are green.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;multi-phase-skills-framework&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="1"><mxGeometry x="1016" y="1183" width="308" height="113" as="geometry"/></mxCell>
        <mxCell id="c3-4-0" value="&lt;b&gt;code-reviewer&lt;/b&gt;&lt;br&gt;Readability, names, duplicated logic and dead code.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-review-agents&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;html=1;" vertex="1" parent="1"><mxGeometry x="1756" y="1183" width="308" height="113" as="geometry"/></mxCell>
        <mxCell id="band4" value="" style="rounded=0;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#cccccc;dashed=1;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="1349" width="2420" height="166" as="geometry"/></mxCell>
        <mxCell id="t4" value="Accessibility" style="rounded=0;whiteSpace=wrap;fillColor=#0050b3;strokeColor=#0050b3;fontStyle=1;fontSize=20;fontColor=#ffffff;verticalAlign=middle;align=center;fontFamily=Helvetica;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="1349" width="200" height="166" as="geometry"/></mxCell>
        <mxCell id="c4-2-0" value="&lt;b&gt;/document-accessibility&lt;/b&gt;&lt;br&gt;Builds a Word or PowerPoint file structure first: title, language, headings, alt text, table headers.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;plain-english-skills&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="1"><mxGeometry x="1016" y="1365" width="308" height="134" as="geometry"/></mxCell>
        <mxCell id="c4-3-0" value="&lt;b&gt;check_doc_a11y.py&lt;/b&gt;&lt;br&gt;Reads the file&amp;#x27;s XML; exit 1 on any barrier.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;plain-english-skills&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;html=1;" vertex="1" parent="1"><mxGeometry x="1386" y="1365" width="308" height="113" as="geometry"/></mxCell>
        <mxCell id="c4-4-0" value="&lt;b&gt;The checks a person makes&lt;/b&gt;&lt;br&gt;Reading order, contrast, the PDF. Ends PASS, PASS WITH FIXES or FAIL. Aligned with SI 5568 and WCAG AA.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;plain-english-skills&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;html=1;" vertex="1" parent="1"><mxGeometry x="1756" y="1365" width="308" height="134" as="geometry"/></mxCell>
        <mxCell id="he1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="h0" target="h1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
