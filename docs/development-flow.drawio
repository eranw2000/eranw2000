<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram id="1" name="1 The public development flow"><mxGraphModel page="1" pageWidth="2340" pageHeight="2200" grid="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;The development flow in the public packs&lt;/b&gt;  |  github.com/eranw2000  |  26 September 2026" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=24;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="30" y="20" width="2280" height="56" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Blue: a skill step Claude runs. Purple: a review agent. Yellow: a file or record it writes. Red: you decide. Grey: a hook or rule that runs by itself.&lt;br&gt;The grey italic line in a box names the repo that ships it." vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;"><mxGeometry x="30" y="92" width="680" height="120" as="geometry" /></mxCell><mxCell id="what" value="&lt;b&gt;What this shows&lt;/b&gt;&lt;br&gt;One piece of work, left to right: plan, build, checkpoint, review, release. A small feature can start at /write-a-prd, and a bug at its failing test. Arrows only link steps that follow each other." vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;"><mxGeometry x="730" y="92" width="680" height="120" as="geometry" /></mxCell><mxCell id="src" value="&lt;b&gt;Read from&lt;/b&gt;&lt;br&gt;The main branch of the nine public repos on GitHub, 26 September 2026." vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;"><mxGeometry x="1430" y="92" width="880" height="120" as="geometry" /></mxCell><mxCell id="col0" value="A. Plan" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#0050b3;fontStyle=1;fontSize=20;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;dashed=1;strokeWidth=2;fontFamily=Helvetica;"><mxGeometry x="30" y="250" width="400" height="1092" as="geometry" /></mxCell><mxCell id="col1" value="B. Build" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#0050b3;fontStyle=1;fontSize=20;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;dashed=1;strokeWidth=2;fontFamily=Helvetica;"><mxGeometry x="500" y="250" width="400" height="1092" as="geometry" /></mxCell><mxCell id="col2" value="C. Checkpoint" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#0050b3;fontStyle=1;fontSize=20;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;dashed=1;strokeWidth=2;fontFamily=Helvetica;"><mxGeometry x="970" y="250" width="400" height="1092" as="geometry" /></mxCell><mxCell id="col3" value="D. Review (/review-round)" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#0050b3;fontStyle=1;fontSize=20;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;dashed=1;strokeWidth=2;fontFamily=Helvetica;"><mxGeometry x="1440" y="250" width="400" height="1092" as="geometry" /></mxCell><mxCell id="col4" value="E. Release (/release)" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#0050b3;fontStyle=1;fontSize=20;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;dashed=1;strokeWidth=2;fontFamily=Helvetica;"><mxGeometry x="1910" y="250" width="400" height="1092" as="geometry" /></mxCell><mxCell id="a1" value="&lt;b&gt;/capture-brainstorming&lt;/b&gt;&lt;br&gt;A rough idea becomes BRAINSTORM.md.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;multi-phase-skills-framework&lt;/font&gt;&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="50" y="306" width="360" height="88" as="geometry" /></mxCell><mxCell id="a2" value="&lt;b&gt;/analyst&lt;/b&gt;&lt;br&gt;Interview, then REQUIREMENTS.md: what and why.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;multi-phase-skills-framework&lt;/font&gt;&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="50" y="428" width="360" height="108" as="geometry" /></mxCell><mxCell id="e-a1-a2" source="a1" target="a2" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a3" value="&lt;b&gt;/architect&lt;/b&gt;&lt;br&gt;SPEC.md with a coverage matrix. You confirm you have read SPEC.md before any slicing.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;multi-phase-skills-framework&lt;/font&gt;&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="50" y="570" width="360" height="127" as="geometry" /></mxCell><mxCell id="e-a2-a3" source="a2" target="a3" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a4" value="&lt;b&gt;Security by risk&lt;/b&gt;&lt;br&gt;/threat-model, /privacy-review and /dependency-review, when the design touches login, personal data or a new package.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;secure-dev-guardrails&lt;/font&gt;&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="50" y="731" width="360" height="127" as="geometry" /></mxCell><mxCell id="e-a3-a4" source="a3" target="a4" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a5" value="&lt;b&gt;/grill-me&lt;/b&gt;&lt;br&gt;One question at a time until every weak spot is fixed or accepted. Terms go to CONTEXT.md.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;multi-phase-skills-framework&lt;/font&gt;&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="50" y="892" width="360" height="127" as="geometry" /></mxCell><mxCell id="e-a4-a5" source="a4" target="a5" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a6" value="&lt;b&gt;/prd-to-issues&lt;/b&gt;&lt;br&gt;Vertical-slice issues on the tracker. A small feature uses /write-a-prd instead.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;multi-phase-skills-framework&lt;/font&gt;&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="50" y="1053" width="360" height="108" as="geometry" /></mxCell><mxCell id="e-a5-a6" source="a5" target="a6" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a7" value="&lt;b&gt;/plan-gate&lt;/b&gt; with the plan-auditor agent&lt;br&gt;A hook reminds you when you leave plan mode. Each weak spot is fixed or accepted by you before any code.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;multi-phase-skills-framework&lt;/font&gt;&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="50" y="1195" width="360" height="127" as="geometry" /></mxCell><mxCell id="e-a6-a7" source="a6" target="a7" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b1" value="&lt;b&gt;/tdd&lt;/b&gt;&lt;br&gt;Red, green, refactor, one vertical slice at a time. Guides for tests, mocking, interfaces and deep modules.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;multi-phase-skills-framework&lt;/font&gt;&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="520" y="306" width="360" height="127" as="geometry" /></mxCell><mxCell id="b2" value="&lt;b&gt;Hooks while writing&lt;/b&gt;&lt;br&gt;secret-scan and pii-in-logs block a secret or personal data in code or logs. dangerous-pattern-warn and sensitive-file-context warn.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;secure-dev-guardrails&lt;/font&gt;&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="520" y="467" width="360" height="147" as="geometry" /></mxCell><mxCell id="b3" value="&lt;b&gt;test-integrity-check&lt;/b&gt;&lt;br&gt;Warns about tests that never run or that default to real data.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-release-workflow&lt;/font&gt;&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="520" y="648" width="360" height="108" as="geometry" /></mxCell><mxCell id="b4" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;Testing and review, validate before you build, measure a new guard, model routing.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;multi-phase-skills-framework rules/&lt;/font&gt;&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="520" y="790" width="360" height="108" as="geometry" /></mxCell><mxCell id="c1" value="&lt;b&gt;/pr-checkpoint&lt;/b&gt;&lt;br&gt;Commits, pushes the feature branch and opens a draft PR. No merge, no production.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-release-workflow&lt;/font&gt;&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="990" y="306" width="360" height="108" as="geometry" /></mxCell><mxCell id="c2" value="&lt;b&gt;Advisory review&lt;/b&gt;&lt;br&gt;code-reviewer, deploy-guard and pr-validator in parallel. Verdict CHECKPOINT-ADVISORY: it never allows a release.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-review-agents&lt;/font&gt;&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="990" y="448" width="360" height="127" as="geometry" /></mxCell><mxCell id="e-c1-c2" source="c1" target="c2" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c3" value="&lt;b&gt;Rebuild local Docker&lt;/b&gt;&lt;br&gt;Test the branch on localhost.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-release-workflow&lt;/font&gt;&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="990" y="609" width="360" height="88" as="geometry" /></mxCell><mxCell id="e-c2-c3" source="c2" target="c3" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="d1" value="&lt;b&gt;Choose the reviewers&lt;/b&gt;&lt;br&gt;code-reviewer always, deploy-guard where the repo deploys, pr-validator where it has tests.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-release-workflow&lt;/font&gt;&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="1460" y="306" width="360" height="127" as="geometry" /></mxCell><mxCell id="d2" value="&lt;b&gt;Adversarial prompts&lt;/b&gt;&lt;br&gt;Each agent is pointed at the 2 or 3 riskiest spots in the diff.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-release-workflow&lt;/font&gt;&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="1460" y="467" width="360" height="108" as="geometry" /></mxCell><mxCell id="e-d1-d2" source="d1" target="d2" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="d3" value="&lt;b&gt;Agents run in parallel&lt;/b&gt;&lt;br&gt;One message, all chosen agents.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-review-agents&lt;/font&gt;&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="1460" y="609" width="360" height="88" as="geometry" /></mxCell><mxCell id="e-d2-d3" source="d2" target="d3" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="d4" value="&lt;b&gt;You pick the fixes&lt;/b&gt;&lt;br&gt;Every finding comes to you first. The rest is recorded, not dropped.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-release-workflow&lt;/font&gt;&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="1460" y="731" width="360" height="108" as="geometry" /></mxCell><mxCell id="e-d3-d4" source="d3" target="d4" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="d5" value="&lt;b&gt;Reproduce, fix, prove&lt;/b&gt;&lt;br&gt;Each fix gets a test that fails without it, then the agents re-run.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-release-workflow&lt;/font&gt;&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="1460" y="873" width="360" height="108" as="geometry" /></mxCell><mxCell id="e-d4-d5" source="d4" target="d5" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="d6" value="&lt;b&gt;Verdict comment&lt;/b&gt;&lt;br&gt;CLEAN @ &amp;lt;head sha&amp;gt; on the PR. /release reads it.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-release-workflow&lt;/font&gt;&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="1460" y="1015" width="360" height="108" as="geometry" /></mxCell><mxCell id="e-d5-d6" source="d5" target="d6" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="&lt;b&gt;Detect the shape&lt;/b&gt;&lt;br&gt;PR mode (merge open PRs) or trunk mode (commit straight to main).&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-release-workflow&lt;/font&gt;&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="1930" y="306" width="360" height="108" as="geometry" /></mxCell><mxCell id="e2" value="&lt;b&gt;Gate&lt;/b&gt;&lt;br&gt;PR mode: one PR at a time, refused while it has blockers. Both modes: a security scan before anything ships.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-release-workflow&lt;/font&gt;&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="1930" y="448" width="360" height="127" as="geometry" /></mxCell><mxCell id="e-e1-e2" source="e1" target="e2" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="&lt;b&gt;Merge or commit, docs, push&lt;/b&gt;&lt;br&gt;README and project notes updated, then origin and every mirror pushed and checked.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-release-workflow&lt;/font&gt;&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="1930" y="609" width="360" height="108" as="geometry" /></mxCell><mxCell id="e-e2-e3" source="e2" target="e3" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="&lt;b&gt;Check the live commit&lt;/b&gt;&lt;br&gt;The deployed commit must equal the pushed one; if a webhook missed, deploy by hand.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-release-workflow&lt;/font&gt;&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="1930" y="751" width="360" height="127" as="geometry" /></mxCell><mxCell id="e-e3-e4" source="e3" target="e4" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="&lt;b&gt;Rebuild local Docker, report&lt;/b&gt;&lt;br&gt;Localhost matches production.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-release-workflow&lt;/font&gt;&lt;/i&gt;" vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="1930" y="912" width="360" height="88" as="geometry" /></mxCell><mxCell id="e-e4-e5" source="e4" target="e5" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-col0-col1" source="col0" target="col1" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=1;exitY=0.04;entryX=0;entryY=0.04;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-col1-col2" source="col1" target="col2" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=1;exitY=0.04;entryX=0;entryY=0.04;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-col2-col3" source="col2" target="col3" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=1;exitY=0.04;entryX=0;entryY=0.04;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-col3-col4" source="col3" target="col4" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=1;exitY=0.04;entryX=0;entryY=0.04;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="guard" value="&lt;b&gt;Guards that run on their own&lt;/b&gt;&lt;br&gt;block-git-push-main refuses a hand push to main (claude-release-workflow). ai-signal-check flags AI writing signals in docs (claude-review-agents). secret-scan also checks every git commit and push for secrets (secure-dev-guardrails)." vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="30" y="1382" width="2280" height="69" as="geometry" /></mxCell><mxCell id="ci" value="&lt;b&gt;Server-side backstop&lt;/b&gt;&lt;br&gt;A reusable GitHub Actions workflow (ci/security-privacy.yml, secure-dev-guardrails) runs a secret scan, Semgrep and a dependency check on every pull request and push, so the checks hold even for someone who does not use Claude Code." vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="30" y="1475" width="2280" height="69" as="geometry" /></mxCell><mxCell id="sess" value="&lt;b&gt;Around every session&lt;/b&gt;&lt;br&gt;/new-session and /next-step to start, /todo for the task list, /instruct to run an instruction file, /save-context or /close-session to end (claude-commands, multi-phase-skills-framework, plain-english-skills). /project-status catches you up after time away (claude-maintenance-skills)." vertex="1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;"><mxGeometry x="30" y="1568" width="2280" height="88" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>