<mxfile host="app.diagrams.net" agent="drawio_build">
  <diagram id="1" name="1 Review checkpoints">
    <mxGraphModel grid="0" page="1" pageWidth="2350" pageHeight="1281">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Review checkpoints in the public packs&lt;/b&gt;  |  github.com/eranw2000  |  9 October 2026" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=24;fontFamily=Helvetica;spacing=10;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="2280" height="56" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Blue: a skill step Claude runs. Purple: a review agent. Yellow: a record it writes. Red: you decide. Grey: a hook that runs by itself.&lt;br&gt;The grey italic line in a box names the repo that ships it." style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="92" width="680" height="120" as="geometry"/></mxCell>
        <mxCell id="what" value="&lt;b&gt;What this shows&lt;/b&gt;&lt;br&gt;The five points where one change is checked on its way to production, left to right. Arrows only link steps that follow each other; the hooks in B run on their own, at every write or commit." style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;html=1;" vertex="1" parent="1"><mxGeometry x="730" y="92" width="680" height="120" as="geometry"/></mxCell>
        <mxCell id="src" value="&lt;b&gt;Read from&lt;/b&gt;&lt;br&gt;The main branch of the public repos on GitHub, 9 October 2026. The full flow, from a rough idea to a release, is the other diagram in this folder." style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;html=1;" vertex="1" parent="1"><mxGeometry x="1430" y="92" width="880" height="120" as="geometry"/></mxCell>
        <mxCell id="stage0" value="A. Before code: plan review" style="rounded=0;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#0050b3;fontStyle=1;fontSize=20;verticalAlign=top;align=center;spacingTop=10;fontFamily=Helvetica;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="250" width="400" height="991" as="geometry"/></mxCell>
        <mxCell id="tm" value="&lt;b&gt;/threat-model&lt;/b&gt;&lt;br&gt;STRIDE and LINDDUN threats at design time. Each mitigation becomes a requirement.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;secure-dev-guardrails&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="stage0"><mxGeometry x="20" y="60" width="360" height="113" as="geometry"/></mxCell>
        <mxCell id="grill" value="&lt;b&gt;/grill-me&lt;/b&gt;&lt;br&gt;One question at a time, each with a recommended answer, until no weak spot in the plan is left open.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;multi-phase-skills-framework&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="stage0"><mxGeometry x="20" y="207" width="360" height="134" as="geometry"/></mxCell>
        <mxCell id="gate" value="&lt;b&gt;/plan-gate with the plan-auditor agent&lt;/b&gt;&lt;br&gt;The agent lists every weak spot in the approved plan. You fix or accept each one before any code is written.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;multi-phase-skills-framework&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;html=1;" vertex="1" parent="stage0"><mxGeometry x="20" y="375" width="360" height="134" as="geometry"/></mxCell>
        <mxCell id="stage1" value="B. At commit" style="rounded=0;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#0050b3;fontStyle=1;fontSize=20;verticalAlign=top;align=center;spacingTop=10;fontFamily=Helvetica;html=1;" vertex="1" parent="1"><mxGeometry x="500" y="250" width="400" height="991" as="geometry"/></mxCell>
        <mxCell id="secret" value="&lt;b&gt;secret-scan&lt;/b&gt;&lt;br&gt;Blocks a write that carries a credential, and scans staged changes on git commit and git push.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;secure-dev-guardrails&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;html=1;" vertex="1" parent="stage1"><mxGeometry x="20" y="60" width="360" height="134" as="geometry"/></mxCell>
        <mxCell id="pii" value="&lt;b&gt;pii-in-logs&lt;/b&gt;&lt;br&gt;Blocks a write that sends personal data to a log.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;secure-dev-guardrails&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;html=1;" vertex="1" parent="stage1"><mxGeometry x="20" y="228" width="360" height="113" as="geometry"/></mxCell>
        <mxCell id="danger" value="&lt;b&gt;dangerous-pattern-warn&lt;/b&gt;&lt;br&gt;Flags injection, weak crypto and path traversal after an edit, so the next turn reviews them.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;secure-dev-guardrails&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;html=1;" vertex="1" parent="stage1"><mxGeometry x="20" y="375" width="360" height="134" as="geometry"/></mxCell>
        <mxCell id="integ" value="&lt;b&gt;test-integrity-check&lt;/b&gt;&lt;br&gt;Warns about a test that can never run, and one missing from a hand-kept call list.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-release-workflow&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;html=1;" vertex="1" parent="stage1"><mxGeometry x="20" y="543" width="360" height="113" as="geometry"/></mxCell>
        <mxCell id="nomain" value="&lt;b&gt;block-git-push-main&lt;/b&gt;&lt;br&gt;Blocks a direct push to main, so every change reaches it through a PR or /release.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-release-workflow&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;html=1;" vertex="1" parent="stage1"><mxGeometry x="20" y="690" width="360" height="113" as="geometry"/></mxCell>
        <mxCell id="stage2" value="C. At the PR" style="rounded=0;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#0050b3;fontStyle=1;fontSize=20;verticalAlign=top;align=center;spacingTop=10;fontFamily=Helvetica;html=1;" vertex="1" parent="1"><mxGeometry x="970" y="250" width="400" height="991" as="geometry"/></mxCell>
        <mxCell id="ckpt" value="&lt;b&gt;/pr-checkpoint&lt;/b&gt;&lt;br&gt;Commits, pushes the feature branch and opens a draft PR. Production is not touched.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-release-workflow&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="stage2"><mxGeometry x="20" y="60" width="360" height="113" as="geometry"/></mxCell>
        <mxCell id="round" value="&lt;b&gt;/review-round&lt;/b&gt;&lt;br&gt;Writes a pointed prompt for each reviewer, then runs the reviewers in parallel.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-release-workflow&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="stage2"><mxGeometry x="20" y="207" width="360" height="113" as="geometry"/></mxCell>
        <mxCell id="agents" value="&lt;b&gt;Review agents&lt;/b&gt;&lt;br&gt;code-reviewer for quality, deploy-guard for deploy safety, pr-validator runs the PR&amp;#x27;s tests.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-review-agents&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;html=1;" vertex="1" parent="stage2"><mxGeometry x="20" y="354" width="360" height="134" as="geometry"/></mxCell>
        <mxCell id="pick" value="&lt;b&gt;You pick the fixes&lt;/b&gt;&lt;br&gt;Each finding comes to you. A fix you pick is reproduced first, then proven by a test that fails without it.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-release-workflow&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;html=1;" vertex="1" parent="stage2"><mxGeometry x="20" y="522" width="360" height="134" as="geometry"/></mxCell>
        <mxCell id="verdict" value="&lt;b&gt;Verdict comment on the PR&lt;/b&gt;&lt;br&gt;CLEAN at the PR&amp;#x27;s head commit, or what is still open.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-release-workflow&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;html=1;" vertex="1" parent="stage2"><mxGeometry x="20" y="690" width="360" height="113" as="geometry"/></mxCell>
        <mxCell id="risk" value="&lt;b&gt;Security, privacy and dependency reviews&lt;/b&gt;&lt;br&gt;/security-review, /privacy-review and /dependency-review run beside the round when the change touches those areas.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;secure-dev-guardrails&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="stage2"><mxGeometry x="20" y="837" width="360" height="134" as="geometry"/></mxCell>
        <mxCell id="stage3" value="D. At merge: /release" style="rounded=0;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#0050b3;fontStyle=1;fontSize=20;verticalAlign=top;align=center;spacingTop=10;fontFamily=Helvetica;html=1;" vertex="1" parent="1"><mxGeometry x="1440" y="250" width="400" height="991" as="geometry"/></mxCell>
        <mxCell id="vgate" value="&lt;b&gt;Verdict gate&lt;/b&gt;&lt;br&gt;Stops on an open Blocker or Critical. Only a CLEAN verdict for the exact head commit certifies a PR. With no verdict it stops and asks you before going on.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-release-workflow&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;html=1;" vertex="1" parent="stage3"><mxGeometry x="20" y="60" width="360" height="154" as="geometry"/></mxCell>
        <mxCell id="merge" value="&lt;b&gt;Merge, docs, push&lt;/b&gt;&lt;br&gt;Merges the PR, updates the README and project notes, then pushes to every remote and reads each live ref back.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-release-workflow&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="stage3"><mxGeometry x="20" y="248" width="360" height="134" as="geometry"/></mxCell>
        <mxCell id="stage4" value="E. After deploy" style="rounded=0;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#0050b3;fontStyle=1;fontSize=20;verticalAlign=top;align=center;spacingTop=10;fontFamily=Helvetica;html=1;" vertex="1" parent="1"><mxGeometry x="1910" y="250" width="400" height="991" as="geometry"/></mxCell>
        <mxCell id="live" value="&lt;b&gt;Live commit check&lt;/b&gt;&lt;br&gt;The live deploy must serve the exact commit pushed. A live but stale deploy is a failure, and a missed deploy is triggered again.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-release-workflow&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="stage4"><mxGeometry x="20" y="60" width="360" height="154" as="geometry"/></mxCell>
        <mxCell id="docker" value="&lt;b&gt;Local Docker rebuilt&lt;/b&gt;&lt;br&gt;Localhost is rebuilt to match production.&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#555555&quot;&gt;claude-release-workflow&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;fontSize=15;fontFamily=Helvetica;spacing=10;align=left;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;" vertex="1" parent="stage4"><mxGeometry x="20" y="248" width="360" height="93" as="geometry"/></mxCell>
        <mxCell id="e-grill" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="stage0" source="tm" target="grill"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-gate" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="stage0" source="grill" target="gate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=1;exitY=0;exitDx=0;exitDy=30;entryX=0;entryY=0;entryDx=0;entryDy=30;" edge="1" parent="1" source="stage0" target="stage1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-round" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="stage2" source="ckpt" target="round"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-agents" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="stage2" source="round" target="agents"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-pick" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="stage2" source="agents" target="pick"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-verdict" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="stage2" source="pick" target="verdict"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=1;exitY=0;exitDx=0;exitDy=30;entryX=0;entryY=0;entryDx=0;entryDy=30;" edge="1" parent="1" source="stage1" target="stage2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-merge" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="stage3" source="vgate" target="merge"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=1;exitY=0;exitDx=0;exitDy=30;entryX=0;entryY=0;entryDx=0;entryDy=30;" edge="1" parent="1" source="stage2" target="stage3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e-docker" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="stage4" source="live" target="docker"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#0050b3;exitX=1;exitY=0;exitDx=0;exitDy=30;entryX=0;entryY=0;entryDx=0;entryDy=30;" edge="1" parent="1" source="stage3" target="stage4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
