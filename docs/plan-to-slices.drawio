<mxfile host="app.diagrams.net" agent="drawio_build">
  <diagram id="page-1" name="Plan to slices">
    <mxGraphModel grid="0" page="1" pageWidth="2968" pageHeight="1121">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h_title" value="&lt;b&gt;From plan to shipped slices&lt;/b&gt;&lt;br&gt;Plan, then spec, then cut the spec into small slices. Each slice gets its own tests and code, then a review, then a release.&lt;br&gt;&lt;br&gt;Read left to right. Stage D repeats once per slice. Grey text names the repo." style="whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="956" height="83" as="geometry"/></mxCell>
        <mxCell id="h_legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Blue box = a skill (a step you run, like /architect).&lt;br&gt;Green box = an agent (a helper started inside that step; it reads and reports).&lt;br&gt;Darker blue = the loop that repeats per slice.&lt;br&gt;Dashed border = when the step calls for it, or your pick.&lt;br&gt;Orange page or yellow drum = a file or record a step leaves behind." style="whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;html=1;" vertex="1" parent="1"><mxGeometry x="986" y="0" width="956" height="116" as="geometry"/></mxCell>
        <mxCell id="h_roles" value="&lt;b&gt;Where the agents sit&lt;/b&gt;&lt;br&gt;plan-auditor checks the plan (B).&lt;br&gt;code-reviewer, deploy-guard and pr-validator review the code (D and E).&lt;br&gt;The skills come from multi-phase-skills-framework, claude-release-workflow and secure-dev-guardrails; the reviewers from claude-review-agents." style="whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;html=1;" vertex="1" parent="1"><mxGeometry x="1972" y="0" width="956" height="83" as="geometry"/></mxCell>
        <mxCell id="st_A" value="A. Plan: what and why" style="whiteSpace=wrap;rounded=0;fillColor=#fafafa;strokeColor=#0050b3;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;dashed=1;strokeWidth=2;fontSize=15;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="156" width="470" height="428" as="geometry"/></mxCell>
        <mxCell id="grill1" value="&lt;b&gt;/grill-me&lt;/b&gt; (optional)&lt;br&gt;Stress-tests the rough idea, one question at a time. /analyst offers it first.&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;&lt;i&gt;multi-phase-skills-framework&lt;/i&gt;&lt;/font&gt;" style="whiteSpace=wrap;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;spacingRight=6;fontSize=12;fontFamily=Helvetica;dashed=1;html=1;" vertex="1" parent="st_A"><mxGeometry x="20" y="44" width="255" height="93" as="geometry"/></mxCell>
        <mxCell id="analyst" value="&lt;b&gt;/analyst&lt;/b&gt;&lt;br&gt;Interviews you and reads the code. Writes REQUIREMENTS.md: the WHAT and WHY, never the HOW.&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;&lt;i&gt;multi-phase-skills-framework&lt;/i&gt;&lt;/font&gt;" style="whiteSpace=wrap;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;spacingRight=6;fontSize=12;fontFamily=Helvetica;html=1;" vertex="1" parent="st_A"><mxGeometry x="20" y="163" width="255" height="93" as="geometry"/></mxCell>
        <mxCell id="poc" value="&lt;b&gt;/build-a-poc&lt;/b&gt; (when a premise needs proof)&lt;br&gt;A throwaway prototype for a question that only a running version can settle, on a slow stack. States the question it answers.&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;&lt;i&gt;multi-phase-skills-framework&lt;/i&gt;&lt;/font&gt;" style="whiteSpace=wrap;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;spacingRight=6;fontSize=12;fontFamily=Helvetica;dashed=1;html=1;" vertex="1" parent="st_A"><mxGeometry x="20" y="282" width="255" height="126" as="geometry"/></mxCell>
        <mxCell id="st_B" value="B. Spec: how" style="whiteSpace=wrap;rounded=0;fillColor=#fafafa;strokeColor=#0050b3;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;dashed=1;strokeWidth=2;fontSize=15;html=1;" vertex="1" parent="1"><mxGeometry x="520" y="156" width="470" height="515" as="geometry"/></mxCell>
        <mxCell id="threat" value="&lt;b&gt;/threat-model&lt;/b&gt; (when the design touches a risky surface)&lt;br&gt;STRIDE and LINDDUN. Writes THREAT-MODEL.md; each fix becomes an NFR-SEC or NFR-PRIV line.&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;&lt;i&gt;secure-dev-guardrails&lt;/i&gt;&lt;/font&gt;" style="whiteSpace=wrap;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;spacingRight=6;fontSize=12;fontFamily=Helvetica;dashed=1;html=1;" vertex="1" parent="st_B"><mxGeometry x="20" y="44" width="255" height="110" as="geometry"/></mxCell>
        <mxCell id="architect" value="&lt;b&gt;/architect&lt;/b&gt;&lt;br&gt;Reads REQUIREMENTS.md, asks you the design questions, then writes SPEC.md: modules and interfaces.&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;&lt;i&gt;multi-phase-skills-framework&lt;/i&gt;&lt;/font&gt;" style="whiteSpace=wrap;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;spacingRight=6;fontSize=12;fontFamily=Helvetica;html=1;" vertex="1" parent="st_B"><mxGeometry x="20" y="180" width="255" height="93" as="geometry"/></mxCell>
        <mxCell id="grill2" value="&lt;b&gt;/grill-me SPEC.md&lt;/b&gt; (optional)&lt;br&gt;Pokes holes in the spec and writes new terms to the CONTEXT.md glossary.&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;&lt;i&gt;multi-phase-skills-framework&lt;/i&gt;&lt;/font&gt;" style="whiteSpace=wrap;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;spacingRight=6;fontSize=12;fontFamily=Helvetica;dashed=1;html=1;" vertex="1" parent="st_B"><mxGeometry x="20" y="299" width="255" height="77" as="geometry"/></mxCell>
        <mxCell id="gate" value="&lt;b&gt;/plan-gate&lt;/b&gt;&lt;br&gt;Every weak spot in the approved plan is fixed or accepted with you before any code.&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;&lt;i&gt;multi-phase-skills-framework&lt;/i&gt;&lt;/font&gt;" style="whiteSpace=wrap;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;spacingRight=6;fontSize=12;fontFamily=Helvetica;html=1;" vertex="1" parent="st_B"><mxGeometry x="20" y="402" width="255" height="93" as="geometry"/></mxCell>
        <mxCell id="gate_ag0" value="&lt;b&gt;plan-auditor&lt;/b&gt;&lt;br&gt;finds the weak spots&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;&lt;i&gt;multi-phase-skills-framework&lt;/i&gt;&lt;/font&gt;" style="whiteSpace=wrap;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;fontSize=12;fontFamily=Helvetica;html=1;" vertex="1" parent="st_B"><mxGeometry x="290" y="402" width="160" height="77" as="geometry"/></mxCell>
        <mxCell id="st_C" value="C. Slice into small units" style="whiteSpace=wrap;rounded=0;fillColor=#fafafa;strokeColor=#0050b3;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;dashed=1;strokeWidth=2;fontSize=15;html=1;" vertex="1" parent="1"><mxGeometry x="1040" y="156" width="470" height="358" as="geometry"/></mxCell>
        <mxCell id="slice" value="&lt;b&gt;/prd-to-issues&lt;/b&gt;&lt;br&gt;Cuts SPEC.md into thin vertical slices (tracer bullets). Each slice goes through every layer: data, API, UI and tests.&lt;br&gt;&lt;br&gt;Slice 1 is the walking skeleton: the smallest end-to-end thing that proves the design. Each issue names the requirement IDs it covers.&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;&lt;i&gt;multi-phase-skills-framework&lt;/i&gt;&lt;/font&gt;" style="whiteSpace=wrap;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;spacingRight=6;fontSize=12;fontFamily=Helvetica;html=1;" vertex="1" parent="st_C"><mxGeometry x="20" y="44" width="255" height="191" as="geometry"/></mxCell>
        <mxCell id="prd" value="&lt;b&gt;/write-a-prd&lt;/b&gt; (instead of A to C)&lt;br&gt;One small, clear feature? It writes one PRD as one issue, ready for /tdd.&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;&lt;i&gt;multi-phase-skills-framework&lt;/i&gt;&lt;/font&gt;" style="whiteSpace=wrap;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;spacingRight=6;fontSize=12;fontFamily=Helvetica;dashed=1;html=1;" vertex="1" parent="st_C"><mxGeometry x="20" y="261" width="255" height="77" as="geometry"/></mxCell>
        <mxCell id="st_D" value="D. Build each slice: code and tests (loop)" style="whiteSpace=wrap;rounded=0;fillColor=#f3f8fe;strokeColor=#1976d2;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;dashed=1;strokeWidth=2;fontSize=15;html=1;" vertex="1" parent="1"><mxGeometry x="1560" y="156" width="470" height="486" as="geometry"/></mxCell>
        <mxCell id="tdd" value="&lt;b&gt;/tdd&lt;/b&gt; (one issue at a time)&lt;br&gt;&lt;b&gt;Red:&lt;/b&gt; one failing test.&lt;br&gt;&lt;b&gt;Green:&lt;/b&gt; the least code that passes it.&lt;br&gt;&lt;b&gt;Refactor&lt;/b&gt;, then the next test.&lt;br&gt;For a bug, the first red test reproduces the bug.&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;&lt;i&gt;multi-phase-skills-framework&lt;/i&gt;&lt;/font&gt;" style="whiteSpace=wrap;rounded=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=2;align=left;spacingLeft=8;spacingRight=6;fontSize=12;fontFamily=Helvetica;html=1;" vertex="1" parent="st_D"><mxGeometry x="20" y="44" width="255" height="126" as="geometry"/></mxCell>
        <mxCell id="checkpoint" value="&lt;b&gt;/pr-checkpoint&lt;/b&gt;&lt;br&gt;Opens a draft PR and rebuilds local Docker so you can try it on localhost. No merge, no production.&lt;br&gt;&lt;br&gt;The reviewers here give advice and you decide.&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;&lt;i&gt;claude-release-workflow&lt;/i&gt;&lt;/font&gt;" style="whiteSpace=wrap;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;spacingRight=6;fontSize=12;fontFamily=Helvetica;html=1;" vertex="1" parent="st_D"><mxGeometry x="20" y="196" width="255" height="142" as="geometry"/></mxCell>
        <mxCell id="checkpoint_ag0" value="&lt;b&gt;code-reviewer&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;&lt;i&gt;claude-review-agents&lt;/i&gt;&lt;/font&gt;" style="whiteSpace=wrap;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;fontSize=12;fontFamily=Helvetica;dashed=1;html=1;" vertex="1" parent="st_D"><mxGeometry x="290" y="196" width="160" height="45" as="geometry"/></mxCell>
        <mxCell id="checkpoint_ag1" value="&lt;b&gt;deploy-guard&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;&lt;i&gt;claude-review-agents&lt;/i&gt;&lt;/font&gt;" style="whiteSpace=wrap;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;fontSize=12;fontFamily=Helvetica;dashed=1;html=1;" vertex="1" parent="st_D"><mxGeometry x="290" y="249" width="160" height="45" as="geometry"/></mxCell>
        <mxCell id="checkpoint_ag2" value="&lt;b&gt;pr-validator&lt;/b&gt;&lt;br&gt;runs the tests&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;&lt;i&gt;claude-review-agents&lt;/i&gt;&lt;/font&gt;" style="whiteSpace=wrap;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;fontSize=12;fontFamily=Helvetica;dashed=1;html=1;" vertex="1" parent="st_D"><mxGeometry x="290" y="302" width="160" height="61" as="geometry"/></mxCell>
        <mxCell id="next" value="&lt;b&gt;Next slice&lt;/b&gt;&lt;br&gt;Pick the next issue and go back to /tdd. Repeat until every issue is done.&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;&lt;i&gt;multi-phase-skills-framework&lt;/i&gt;&lt;/font&gt;" style="whiteSpace=wrap;rounded=1;fillColor=#bbdefb;strokeColor=#1976d2;strokeWidth=2;align=left;spacingLeft=8;spacingRight=6;fontSize=12;fontFamily=Helvetica;html=1;" vertex="1" parent="st_D"><mxGeometry x="20" y="389" width="255" height="77" as="geometry"/></mxCell>
        <mxCell id="st_E" value="E. Review and ship" style="whiteSpace=wrap;rounded=0;fillColor=#fafafa;strokeColor=#0050b3;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;dashed=1;strokeWidth=2;fontSize=15;html=1;" vertex="1" parent="1"><mxGeometry x="2080" y="156" width="470" height="485" as="geometry"/></mxCell>
        <mxCell id="review" value="&lt;b&gt;/review-round&lt;/b&gt;&lt;br&gt;Writes hard prompts for each reviewer. You pick which findings to fix; each fix gets a test that fails without it. Posts the PR verdict that /release reads.&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;&lt;i&gt;claude-release-workflow&lt;/i&gt;&lt;/font&gt;" style="whiteSpace=wrap;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;spacingRight=6;fontSize=12;fontFamily=Helvetica;html=1;" vertex="1" parent="st_E"><mxGeometry x="20" y="44" width="255" height="126" as="geometry"/></mxCell>
        <mxCell id="review_ag0" value="&lt;b&gt;code-reviewer&lt;/b&gt;&lt;br&gt;your pick&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;&lt;i&gt;claude-review-agents&lt;/i&gt;&lt;/font&gt;" style="whiteSpace=wrap;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;fontSize=12;fontFamily=Helvetica;dashed=1;html=1;" vertex="1" parent="st_E"><mxGeometry x="290" y="44" width="160" height="61" as="geometry"/></mxCell>
        <mxCell id="review_ag1" value="&lt;b&gt;deploy-guard&lt;/b&gt;&lt;br&gt;your pick&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;&lt;i&gt;claude-review-agents&lt;/i&gt;&lt;/font&gt;" style="whiteSpace=wrap;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;fontSize=12;fontFamily=Helvetica;dashed=1;html=1;" vertex="1" parent="st_E"><mxGeometry x="290" y="113" width="160" height="61" as="geometry"/></mxCell>
        <mxCell id="review_ag2" value="&lt;b&gt;pr-validator&lt;/b&gt;&lt;br&gt;your pick&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;&lt;i&gt;claude-review-agents&lt;/i&gt;&lt;/font&gt;" style="whiteSpace=wrap;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;fontSize=12;fontFamily=Helvetica;dashed=1;html=1;" vertex="1" parent="st_E"><mxGeometry x="290" y="182" width="160" height="61" as="geometry"/></mxCell>
        <mxCell id="release" value="&lt;b&gt;/release&lt;/b&gt;&lt;br&gt;Ships only on a CLEAN verdict for the exact commit, merges, pushes to every remote, then checks the auto-deploy.&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;&lt;i&gt;claude-release-workflow&lt;/i&gt;&lt;/font&gt;" style="whiteSpace=wrap;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;spacingRight=6;fontSize=12;fontFamily=Helvetica;html=1;" vertex="1" parent="st_E"><mxGeometry x="20" y="269" width="255" height="93" as="geometry"/></mxCell>
        <mxCell id="gss" value="&lt;b&gt;/plan-status-sheet&lt;/b&gt;&lt;br&gt;Keeps the plan-status Google Sheet in step with the plan.&lt;br&gt;&lt;font color=&#x27;#666666&#x27;&gt;&lt;i&gt;multi-phase-skills-framework&lt;/i&gt;&lt;/font&gt;" style="whiteSpace=wrap;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;spacingRight=6;fontSize=12;fontFamily=Helvetica;html=1;" vertex="1" parent="st_E"><mxGeometry x="20" y="388" width="255" height="77" as="geometry"/></mxCell>
        <mxCell id="band" value="Files and records each step leaves" style="whiteSpace=wrap;rounded=0;fillColor=#fffbe6;strokeColor=#d6b656;strokeWidth=2;dashed=1;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=15;html=1;" vertex="1" parent="1"><mxGeometry x="2600" y="156" width="300" height="818" as="geometry"/></mxCell>
        <mxCell id="a_req" value="&lt;b&gt;REQUIREMENTS.md&lt;/b&gt;&lt;br&gt;from /analyst" style="whiteSpace=wrap;shape=document;boundedLbl=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontFamily=Helvetica;html=1;" vertex="1" parent="band"><mxGeometry x="20" y="44" width="260" height="73" as="geometry"/></mxCell>
        <mxCell id="a_threat" value="&lt;b&gt;THREAT-MODEL.md&lt;/b&gt;&lt;br&gt;from /threat-model" style="whiteSpace=wrap;shape=document;boundedLbl=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontFamily=Helvetica;html=1;" vertex="1" parent="band"><mxGeometry x="20" y="131" width="260" height="73" as="geometry"/></mxCell>
        <mxCell id="a_spec" value="&lt;b&gt;SPEC.md&lt;/b&gt;&lt;br&gt;from /architect" style="whiteSpace=wrap;shape=document;boundedLbl=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontFamily=Helvetica;html=1;" vertex="1" parent="band"><mxGeometry x="20" y="218" width="260" height="73" as="geometry"/></mxCell>
        <mxCell id="a_context" value="&lt;b&gt;CONTEXT.md&lt;/b&gt;&lt;br&gt;the glossary, from /grill-me" style="whiteSpace=wrap;shape=document;boundedLbl=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontFamily=Helvetica;html=1;" vertex="1" parent="band"><mxGeometry x="20" y="305" width="260" height="73" as="geometry"/></mxCell>
        <mxCell id="a_issues" value="&lt;b&gt;Issues on the tracker&lt;/b&gt;&lt;br&gt;one per slice, from /prd-to-issues" style="whiteSpace=wrap;shape=cylinder3;size=15;boundedLbl=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;" vertex="1" parent="band"><mxGeometry x="20" y="392" width="260" height="91" as="geometry"/></mxCell>
        <mxCell id="a_branch" value="&lt;b&gt;Tests and code&lt;/b&gt;&lt;br&gt;on the feature branch, from /tdd" style="whiteSpace=wrap;shape=cylinder3;size=15;boundedLbl=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;" vertex="1" parent="band"><mxGeometry x="20" y="497" width="260" height="91" as="geometry"/></mxCell>
        <mxCell id="a_pr" value="&lt;b&gt;Draft PR and its verdict&lt;/b&gt;&lt;br&gt;from /pr-checkpoint and /review-round" style="whiteSpace=wrap;shape=cylinder3;size=15;boundedLbl=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;" vertex="1" parent="band"><mxGeometry x="20" y="602" width="260" height="91" as="geometry"/></mxCell>
        <mxCell id="a_gss" value="&lt;b&gt;Plan-status Google Sheet&lt;/b&gt;&lt;br&gt;from /plan-status-sheet" style="whiteSpace=wrap;shape=cylinder3;size=15;boundedLbl=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;" vertex="1" parent="band"><mxGeometry x="20" y="707" width="260" height="91" as="geometry"/></mxCell>
        <mxCell id="footer" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;Other route: /architect can scaffold an OpenSpec change instead of issues (/opsx:propose, then /opsx:apply per task), when you ask for it.&lt;br&gt;Reviewers in /pr-checkpoint give advice. /review-round is where you decide what gets fixed, and /release ships only on its CLEAN verdict for the current commit." style="whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fontFamily=Helvetica;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="1014" width="2880" height="67" as="geometry"/></mxCell>
        <mxCell id="e_grill1_analyst" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;html=1;strokeColor=#6c8ebf;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="grill1" target="analyst"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_analyst_poc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;html=1;strokeColor=#6c8ebf;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="analyst" target="poc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_threat_architect" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;html=1;strokeColor=#6c8ebf;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="threat" target="architect"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_architect_grill2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=classic;html=1;strokeColor=#6c8ebf;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="architect" target="grill2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
